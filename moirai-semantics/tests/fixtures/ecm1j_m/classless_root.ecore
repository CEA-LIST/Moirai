<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="lib" nsURI="urn:lib" nsPrefix="lib">
  <eClassifiers xsi:type="ecore:EEnum" name="Mode">
    <eLiterals name="ON"/>
    <eLiterals name="OFF" value="1"/>
  </eClassifiers>
  <eSubpackages name="model" nsURI="urn:lib/model" nsPrefix="model">
    <eClassifiers xsi:type="ecore:EClass" name="Model">
      <eStructuralFeatures xsi:type="ecore:EReference" name="parts" upperBound="-1" eType="#//model/Part" containment="true"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="Part">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" eType="#//Mode"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>
